# Copy to .env.server (never commit it). Every key is optional in dev:
# missing ElevenLabs key -> public agent via ELEVENLABS_AGENT_ID
# missing Alter keys     -> follow-up send is a logged dry run

# ElevenLabs: used server-side to mint a signed URL for a private agent
ELEVENLABS_API_KEY=
# The agent you created in the dashboard from agent/prompt.md + agent/tools.json
ELEVENLABS_AGENT_ID=

# Alter: approval-gated proxy for the Resend call
ALTER_API_KEY=
# Grant id of the Resend connection inside Alter (Alter holds the Resend key)
ALTER_RESEND_GRANT_ID=

# Resend: only needed if you store it in Alter yourself; not read by the server when Alter is used
RESEND_API_KEY=
# Sender address verified in Resend, e.g. evee <hello@yourdomain.com>
FROM_EMAIL=

# Database (Prisma, SQLite in dev)
DATABASE_URL=file:./dev.db

ANTHROPIC_API_KEY=
# eevee backend (backend/cloudflare). Leave empty to run without it: slides then
# come only from the ElevenLabs agent's show_slide tool.
EEVEE_API_URL=https://eevee.yyznate.workers.dev
# The Worker's APP_API_KEY (server-side only, never sent to the browser)
EEVEE_API_KEY=
