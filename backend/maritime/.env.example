# Shared service secrets are generated by `npm run setup:local` in cloudflare/.
MARITIME_SERVICE_TOKEN=replace-with-same-value-as-cloudflare
INTERNAL_SERVICE_TOKEN=replace-with-same-value-as-cloudflare
CLOUDFLARE_ORIGIN=https://eevee.yyznate.workers.dev
SMART_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5
# Claude API key from https://platform.claude.com (a Claude Pro/Max plan does not include API access).
# Set it as a secret in the agent's Env tab; never commit it.
ANTHROPIC_API_KEY=replace-with-claude-api-key
